# Copie para .env e preencha. NUNCA versione o .env com valores reais.

# --- Firebase (Admin SDK) ---
# Service account JSON inteiro, codificado em base64.
FIREBASE_SERVICE_ACCOUNT_BASE=

# --- Autenticação ---
# Segredo de assinatura do JWT (string longa e aleatória).
JWT_SECRET=

# --- Servidor ---
PORT=8080
# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:4200,https://barbarafarias.com.br

# --- Geração de material (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- E-mail transacional (Resend) ---
# Única variável obrigatória: a chave da API.
RESEND_API_KEY=
# OPCIONAL. Sem esta variável o SDK usa o remetente compartilhado da Resend
# (onboarding@resend.dev), que já funciona. Defina o domínio próprio quando ele
# estiver verificado na Resend (SPF/DKIM no DNS) para enviar a qualquer destino.
# RESEND_FROM="Bárbara Farias <no-reply@barbarafarias.com.br>"

FIREBASE_STORAGE_BUCKET=

# --- Pagamentos (AbacatePay) ---
# Chave da API. Sem ela o módulo de assinaturas sobe, mas nenhuma cobrança é
# gerada de verdade — o plano fica PENDING e o log avisa (spec 012 §3).
ABACATEPAY_API_KEY=
# Segredo que o AbacatePay devolve no webhook (query `webhookSecret`). Sem ele
# o webhook é recusado com 401.
#
# Cadastre no painel do AbacatePay (Configurações → Webhooks) a URL abaixo, com
# o mesmo valor desta variável na query — é ela que autentica a chamada, já que
# a rota é pública:
#
#   produção  https://api.barbarafarias.com.br/webhooks/abacatepay?webhookSecret=SEU_SEGREDO
#   staging   https://dev-api.barbarafarias.com.br/webhooks/abacatepay?webhookSecret=SEU_SEGREDO
#
# O AbacatePay não alcança `localhost`: para testar o webhook na sua máquina,
# exponha a porta com um túnel (`ngrok http 3000`) e cadastre a URL pública dele
# terminando em `/webhooks/abacatepay?webhookSecret=…`. Para o fluxo do dia a
# dia não é preciso: `DEV_MODE=true` libera a simulação de pagamento abaixo.
ABACATEPAY_WEBHOOK_SECRET=
# Libera a rota POST /subscriptions/dev/mock-pay, que simula a confirmação do
# PIX no ambiente local. NUNCA `true` em produção.
DEV_MODE=false
# Base do frontend, usada nas URLs de retorno do checkout de cartão.
APP_BASE_URL=http://localhost:4200

# --- Pagamentos (Stripe, cartão de crédito — spec 014) ---
# O PIX continua no AbacatePay; o cartão é do Stripe. Sem esta chave o módulo
# sobe normalmente e a contratação por cartão devolve o mesmo aviso de cobrança
# indisponível que o PIX sem chave.
#
# Prefira uma **chave restrita** (`rk_…`) a uma secreta (`sk_…`). O escopo
# mínimo desta integração é: Checkout Sessions (write), Customers (write),
# Products/Prices (write), Coupons (write), Subscriptions (write) e
# Events (read, para o webhook de conteúdo mínimo).
STRIPE_SECRET_KEY=
# Os webhooks são **dois**, um para cada estilo de payload do painel do Stripe:
# "instantâneo" (snapshot, evento inteiro no corpo) e "mínimo" (thin, só o id e
# o tipo — a API é consultada para buscar o resto). Cada endpoint do Stripe tem
# a **sua própria** chave de assinatura, então são duas variáveis: usar a do
# outro endpoint faz a verificação falhar com "No signatures found".
#
#   produção  https://api.barbarafarias.com.br/stripe/webhook/conteudo-instantaneo
#             https://api.barbarafarias.com.br/stripe/webhook/conteudo-minimo
#   staging   https://dev-api.barbarafarias.com.br/stripe/webhook/conteudo-instantaneo
#             https://dev-api.barbarafarias.com.br/stripe/webhook/conteudo-minimo
#
# Local, sem túnel — o CLI do Stripe imprime o `whsec_` a usar:
#   stripe listen --forward-to http://localhost:3000/stripe/webhook/conteudo-instantaneo
STRIPE_WEBHOOK_SECRET_SNAPSHOT=
STRIPE_WEBHOOK_SECRET_THIN=
