{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/src/main.ts"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/plan-prices",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/internal/cron/turmas",
      "schedule": "0 11 * * *"
    }
  ]
}
